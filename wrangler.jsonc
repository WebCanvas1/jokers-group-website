{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jokers-group-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jokers-group-db",
      "database_id": "aac68380-a125-4b11-99cd-1be728a89859"
    }
  ]
}
